{
  "name": "@senkiro/station-3d",
  "version": "0.1.0",
  "private": true,
  "description": "SENKIRO indoor station engine — StationGraph build/validation, lexicographic step-free routing, 2D split-panel plan and imperative Three.js scene behind a thin React bridge.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint --error-on-warnings .",
    "check": "biome check --error-on-warnings .",
    "test": "vitest run"
  },
  "dependencies": {
    "@senkiro/contracts": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": ">=0.180.0"
  },
  "devDependencies": {
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "jsdom": "31.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  }
}
