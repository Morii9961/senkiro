{
  "name": "senkiro",
  "version": "0.0.0",
  "private": true,
  "description": "SENKIRO — honest, source-traceable Japanese railway atlas, route, fare and journey monorepo.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.33.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome lint --error-on-warnings .",
    "format": "biome format --write .",
    "check": "biome check --error-on-warnings . && turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @senkiro/web test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
