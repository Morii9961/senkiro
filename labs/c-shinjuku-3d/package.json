{
  "name": "senkiro-lab-c-shinjuku-3d",
  "private": true,
  "version": "0.1.0",
  "description": "SENKIRO Lab · Shinjuku Station 3D — schematic multi-level station model with indoor routing",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "data:build": "tsx scripts/build-data.ts",
    "data:check": "tsx scripts/build-data.ts --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run data:check && npm run typecheck && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "perf": "node scripts/run-e2e.mjs --grep @perf"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
