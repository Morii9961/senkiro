{
  "name": "senkiro-lab-umeda-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "data:build": "node --experimental-strip-types scripts/build-data.ts",
    "data:check": "node --experimental-strip-types scripts/build-data.ts --check",
    "build": "npm run data:check && tsc --noEmit && vite build",
    "preview": "vite preview",
    "check:routes": "node --experimental-strip-types scripts/check-routes.ts",
    "test": "npm run check:routes && vitest run && npm run test:e2e",
    "test:e2e": "node scripts/browser.mjs && playwright test"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "~0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "~0.180.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
